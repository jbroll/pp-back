#!/bin/sh
# shellcheck disable=SC1090,SC2029,SC2012,SC2129
# SC1090: Dynamic config sourcing is intentional
# SC2029: Client-side SSH expansion is intentional
# SC2012: ls needed for sorted directory listing
# SC2129: Separate cat commands are clearer than grouped redirects
#
# Push/Pull Backup
#
# This script depends on /bin/sh, ssh, rsync, awk, mkdir, ls, date, echo, rm, basename, sed, and mktemp.
#
# 
# The script is invoked as:
#
# > pp-back /path/to/config/name
#
#  It reads in a configuration file with the .ppb extension, the extension is not
#  included in the config name on the command line.  In the config file the
#  following items are specified:
#
#  ----- example: clark.ppb --------------------------------------
#
#    name=clark     		# The name of the back up config.
#    mode=pull			# The mode, push data to or pull data from remote
#    host=root@clark.lco.cl	# Name of the remote host
#    link=yes			# Link to previous data dir is available.
#    save=14			# Keep last N daily backups (default: 14)
#    monthly=12			# Keep last N monthly backups (default: 12)
#    delete=no			# Delete files in the backup that no longer exist.
#
#    prefix=/backup/clark	# Where to put the backup
#
#    # the data variable is a list of directories to backup for this config.
#    #
#    data="/etc
#          /home
#	   /usr/local
#	   /data/mmti
#	   /data/IRAF
#    "
#  ---------------------------------------------------------------
#
# Backup directories are created under the $prefix directory with form: YYYY.MMDD,
# for example: 2011.1010 is created io October 10, 2010.
#
# Retention: Backups are kept in three tiers:
#   - Yearly:  First backup of each year (kept forever)
#   - Monthly: First backup of each month (keep last $monthly)
#   - Daily:   All other backups (keep last $save)
#
# Local backups can be done by specifying host="" and mode=pull.
#
# 
# Files to be excluded from the backup can be indicated with patterns in these files:
#
#  $name.ppb.exclude			# The directory where the config file is located
#  $data/$name.ppb.exclude		# Each source directory has its own excludes at its root.
#  $prefix/$name.ppb.exclude		# The config has an exclude at the target prefix directory.
#  $prefix/$name.ppb.$data.exclude	# Each source directory has its won exlucdes in the 
#					# target prefix directory.
# 
#
# shellcheck disable=SC2154  # Variables from sourced config: host, name, mode, prefix, data, save
link=yes
colon=":"
dryrun=""
save=14
monthly=12
link_depth=20

# sq: single-quote a string for remote shell use
sq() { printf "'%s'" "$(printf "%s" "$1" | sed "s/'/'\\\\''/g")"; }

set -e
tmpfile=$(mktemp) || exit 1

while getopts "n" opt; do
    case $opt in
        n) dryrun="-n" ;;
        *) echo "pp-back [-n] <tag>" >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

if [ "$#" -ne 1 ] ; then
    echo "pp-back [-n] <tag>" >&2
    exit 1
fi

if [ ! -f "$1.ppb" ] ; then
    echo "pp-back: no config file" >&2
    exit 1
fi

# shellcheck disable=SC3067  # -O supported by bash/dash target shells
if [ ! -O "$1.ppb" ] ; then
    echo "pp-back: config must be owned by you" >&2
    exit 1
fi

case $1 in
 /*) config="$1.ppb" ; config_excl="$1.ppb.exclude" ;;
 *)  config="$(pwd)/$1.ppb" ; config_excl="$(pwd)/$1.ppb.exclude" ;;
esac
ACTION=PRE_BACKUP . "$config"

TODAY=$(date +%Y.%m%d)

case $save in ''|*[!0-9]*) echo "pp-back: save must be a number" >&2; exit 1 ;; esac
case $monthly in ''|*[!0-9]*) echo "pp-back: monthly must be a number" >&2; exit 1 ;; esac

case $mode in
    push|pull) ;;
    *) echo "pp-back: unknown mode '$mode'" >&2; exit 1 ;;
esac

if [ "$mode" = push ] && [ -z "$host" ]; then
    echo "pp-back: push mode requires host" >&2
    exit 1
fi

# Always run POST_BACKUP, preserving exit status
trap 'rc=$?; ACTION=POST_BACKUP . "$config"; rm -f "$tmpfile"; exit $rc' EXIT INT TERM

if [ "$host"   = ""    ] ; then  colon="";         fi
if [ "$delete" = "yes" ] ; then  delete=--delete;  else delete=""; fi

allpattern='20[0-9][0-9].[0-9][0-9][0-9][0-9]'

excl=$name.ppb.exclude
Excl="--exclude-from=$tmpfile"

echo "pp-back : $mode : $(date)"

case $mode in
 push)
    if ! ssh "$host" "mkdir -p -- $(sq "$prefix")" ; then
        echo "cannot mkdir -p $prefix on remote $host" >&2
        exit 1
    fi

    if [ "$link" = yes ] ; then
        # shellcheck disable=SC2086  # $linker intentionally splits into multiple --link-dest
        linker=$(ssh "$host" "cd $(sq "$prefix") && ls -dr $allpattern" 2>/dev/null | head -n "$link_depth" | awk '{ print "--link-dest ../" $1 }')
    fi

    for source in $data ; do
        : > "$tmpfile"

        cat "$config_excl" >> "$tmpfile" 2>/dev/null || true
        cat "$source/$excl" >> "$tmpfile" 2>/dev/null || true
        ssh "$host" "cat $(sq "$prefix/$excl")" >> "$tmpfile" 2>/dev/null || true
        ssh "$host" "cat $(sq "$prefix/$name.ppb.$(basename "$source").exclude")" >> "$tmpfile" 2>/dev/null || true

        # shellcheck disable=SC2086  # $dryrun/$delete/$linker intentionally split
        echo rsync $dryrun -avz $delete $linker "$Excl" "$source" "$host$colon$prefix/$TODAY"
        # shellcheck disable=SC2086  # $dryrun/$delete/$linker intentionally split
        rsync $dryrun -avz $delete $linker "$Excl" "$source" "$host$colon$prefix/$TODAY"
    done

    # shellcheck disable=SC2087  # Variables intentionally expanded client-side
    ssh "$host" /bin/sh <<EOF
        if cd $(sq "$prefix") ; then
            todelete=\$(ls -d $allpattern 2>/dev/null | awk -v daily="$save" -v monthly="$monthly" '
            {
                ym = substr(\$1, 1, 7)
                if (!(ym in seen)) {
                    seen[ym] = 1
                    if (!y[substr(\$1,1,4)]++) next
                    mo[++mc] = \$1
                    if (monthly && mc > monthly) print mo[mc - monthly]
                } else {
                    da[++dc] = \$1
                    if (dc > daily) print da[dc - daily]
                }
            }')
            if [ "\$todelete" != "" ] ; then
                if [ "$dryrun" = "-n" ] ; then
                    for d in \$todelete; do echo "would delete: \$d"; done
                else
                    chmod -Rf +w -- \$todelete 2>/dev/null
                    rm -fr -- \$todelete
                fi
            fi
        fi
EOF
 ;;

 pull)
    if ! mkdir -p "$prefix" ; then
        echo "cannot mkdir -p $prefix" >&2
        exit 1
    fi

    if [ "$link" = yes ] ; then
        # shellcheck disable=SC2086  # $allpattern is a glob
        linker=$(cd "$prefix" && ls -dr $allpattern 2>/dev/null | head -n "$link_depth" | awk '{ print "--link-dest ../" $1 }')
    fi

    for source in $data ; do
        : > "$tmpfile"

        cat "$config_excl" >> "$tmpfile" 2>/dev/null || true
        if [ -n "$host" ] ; then
            ssh "$host" "cat $(sq "$source/$excl")" >> "$tmpfile" 2>/dev/null || true
        else
            cat "$source/$excl" >> "$tmpfile" 2>/dev/null || true
        fi
        cat "$prefix/$excl" >> "$tmpfile" 2>/dev/null || true
        cat "$prefix/$name.ppb.$(basename "$source").exclude" >> "$tmpfile" 2>/dev/null || true

        # shellcheck disable=SC2086  # $dryrun/$delete/$linker intentionally split
        echo rsync $dryrun -avz $delete $linker "$Excl" "$host$colon$source" "$prefix/$TODAY"
        # shellcheck disable=SC2086  # $dryrun/$delete/$linker intentionally split
        rsync $dryrun -avz $delete $linker "$Excl" "$host$colon$source" "$prefix/$TODAY"
    done

    # shellcheck disable=SC2086  # $allpattern is a glob, $todelete is multi-dir
    if cd "$prefix" ; then
        todelete=$(ls -d $allpattern 2>/dev/null | awk -v daily="$save" -v monthly="$monthly" '
        {
            ym = substr($1, 1, 7)
            if (!(ym in seen)) {
                seen[ym] = 1
                if (!y[substr($1,1,4)]++) next
                mo[++mc] = $1
                if (monthly && mc > monthly) print mo[mc - monthly]
            } else {
                da[++dc] = $1
                if (dc > daily) print da[dc - daily]
            }
        }')
        if [ "$todelete" != "" ] ; then
            if [ "$dryrun" = "-n" ] ; then
                for d in $todelete; do echo "would delete: $d"; done
            else
                chmod -Rf +w -- $todelete 2>/dev/null
                rm -fr -- $todelete
            fi
        fi
    fi
 ;;
esac

echo "pp-back : $mode : $(date)"

